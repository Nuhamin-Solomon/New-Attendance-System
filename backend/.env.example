# ---------------------------------------------------------------------------
# Attendance System - Backend environment template
# Copy to backend/.env for local development, and set the SAME variables in
# Vercel (Project -> Settings -> Environment Variables) for production.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Server ---
# Port the backend listens on (local only; Vercel ignores this)
PORT=5000
# Set NODE_ENV=production on Vercel (Vercel sets this automatically)
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call this API.
# Vercel frontend domains (*.vercel.app) are allowed automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
# Preferred: single connection string (managed Postgres on Vercel).
# DATABASE_URL=postgres://user:password@host:5432/attendance_db
# With DATABASE_URL set, DB_SSL defaults to true for managed hosts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=your_user
DB_PASSWORD=your_password
# Force SSL for Postgres when needed (true/false)
# DB_SSL=true

# --- Authentication ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Max lifetime of a JWT (hard cap). Sliding inactivity timeout is below.
JWT_EXPIRY=24h
# Auto-logout after this many minutes of inactivity (default 30).
SESSION_TIMEOUT_MINUTES=30
# Forgot-password reset token lifetime in minutes (default 60).
PASSWORD_RESET_TTL_MINUTES=60

# --- BioTime biometric device ---
# Internal network only. If this backend runs on Vercel serverless, it will
# NOT be able to reach an internal BioTime device; the sync loop will simply
# log errors. Keep fullSync/attendance summaries running on the office host.
BIOTIME_URL=http://172.16.11.241:5000
# How often to auto-sync from BioTime (ms). Non-Vercel hosts only.
BIOTIME_SYNC_INTERVAL_MS=60000